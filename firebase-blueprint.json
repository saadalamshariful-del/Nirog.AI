{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root authenticated user workspace holding non-PII preferences and Google Drive folder sync metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the user's own workspace banner.",
          "maxLength": 160
        },
        "diaryOn": {
          "type": "boolean",
          "description": "Whether medicine adherence reminders are active."
        },
        "diaryDaysMask": {
          "type": "string",
          "description": "7-character adherence bitmask for days 0..6 (e.g. 1110000).",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[01]{7}$"
        },
        "driveFolderId": {
          "type": "string",
          "description": "Google Drive folder ID storing NIROG.AI database backups.",
          "maxLength": 128
        },
        "driveFolderName": {
          "type": "string",
          "description": "Google Drive folder display name.",
          "maxLength": 120
        },
        "driveFileId": {
          "type": "string",
          "description": "Google Drive JSON database file ID.",
          "maxLength": 128
        },
        "lastDriveSyncIso": {
          "type": "string",
          "description": "ISO-8601 timestamp of the latest Google Drive backup.",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of workspace creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["uid", "displayName", "diaryOn", "diaryDaysMask", "createdAt", "updatedAt"]
    },
    "PrivateProfile": {
      "title": "PrivateProfile",
      "description": "Owner-isolated PII record storing user email separately from root workspace state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "WorkspaceOrder": {
      "title": "WorkspaceOrder",
      "description": "Pharmacy order summary persisted under a user's workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["received", "rx_review", "confirmed", "packed", "dispatched", "delivered"]
        },
        "payMethod": {
          "type": "string",
          "enum": ["cod", "card", "mfs"]
        },
        "totalBdt": {
          "type": "number"
        },
        "itemCount": {
          "type": "number"
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "ref", "status", "payMethod", "totalBdt", "itemCount", "summary", "createdAt"]
    },
    "WorkspaceSupportCase": {
      "title": "WorkspaceSupportCase",
      "description": "Patient Support Programme application persisted under a user's workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "program": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "under_review", "more_info", "approved", "withdrawn"]
        },
        "summary": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "ref", "program", "status", "summary", "createdAt"]
    },
    "WorkspaceAppointment": {
      "title": "WorkspaceAppointment",
      "description": "Provider outpatient appointment persisted under an authenticated user's workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patient": {
          "type": "string",
          "maxLength": 120
        },
        "time": {
          "type": "string",
          "maxLength": 40
        },
        "reason": {
          "type": "string",
          "maxLength": 240
        },
        "status": {
          "type": "string",
          "enum": ["Scheduled", "Waiting", "In Review", "Completed"]
        },
        "vitals": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "ref", "patient", "time", "reason", "status", "vitals", "createdAt"]
    },
    "WorkspacePvReport": {
      "title": "WorkspacePvReport",
      "description": "Pharmacovigilance ADR safety submission stored in user workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reporter": {
          "type": "string",
          "maxLength": 80
        },
        "product": {
          "type": "string",
          "maxLength": 120
        },
        "severity": {
          "type": "string",
          "enum": ["Mild", "Moderate", "Severe / Seek urgent care"]
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["Received", "Under Pharmacovigilance Review", "Closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "ref", "reporter", "product", "severity", "description", "status", "createdAt"]
    },
    "DriveBackupRecord": {
      "title": "DriveBackupRecord",
      "description": "Audit log record of a Google Drive database snapshot saved to the user's folder.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "folderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fileName": {
          "type": "string",
          "maxLength": 160
        },
        "folderName": {
          "type": "string",
          "maxLength": 120
        },
        "recordCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fileId", "folderId", "fileName", "folderName", "recordCount", "createdAt"]
    },
    "WorkspaceSourcingRequest": {
      "title": "WorkspaceSourcingRequest",
      "description": "Hospital & clinic direct global sourcing and DGDA NPA / compassionate use request persisted under a user's workspace.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hospitalName": {
          "type": "string",
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": [
            "Unapproved / Unavailable Medicine",
            "Hospital Beds",
            "Clinical Equipment & Devices",
            "Robotic Surgery Systems"
          ]
        },
        "originHub": {
          "type": "string",
          "enum": [
            "China NMPA Originator Hub",
            "China MedTech Partner",
            "Turkey MedTech Partner"
          ]
        },
        "itemName": {
          "type": "string",
          "maxLength": 200
        },
        "quantity": {
          "type": "number"
        },
        "dgdaAssistance": {
          "type": "boolean"
        },
        "patientOrDeptContext": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "DGDA Filing / Partner Quote",
            "Approved / In Transit"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "ref",
        "hospitalName",
        "category",
        "originHub",
        "itemName",
        "quantity",
        "dgdaAssistance",
        "patientOrDeptContext",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/workspaces/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "User workspace root document holding non-PII preferences and Google Drive folder metadata."
    },
    "/workspaces/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/PrivateProfile" },
      "description": "Owner-isolated PII record containing user email."
    },
    "/workspaces/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/WorkspaceOrder" },
      "description": "Pharmacy orders persisted under a user's workspace."
    },
    "/workspaces/{userId}/supportCases/{caseId}": {
      "schema": { "$ref": "#/entities/WorkspaceSupportCase" },
      "description": "Patient Support Programme cases persisted under a user's workspace."
    },
    "/workspaces/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/WorkspaceAppointment" },
      "description": "Provider outpatient appointments persisted under a user's workspace."
    },
    "/workspaces/{userId}/pvReports/{reportId}": {
      "schema": { "$ref": "#/entities/WorkspacePvReport" },
      "description": "Pharmacovigilance ADR safety reports persisted under a user's workspace."
    },
    "/workspaces/{userId}/driveBackups/{backupId}": {
      "schema": { "$ref": "#/entities/DriveBackupRecord" },
      "description": "History of database snapshot files exported to the user's Google Drive folder."
    },
    "/workspaces/{userId}/sourcingRequests/{requestId}": {
      "schema": { "$ref": "#/entities/WorkspaceSourcingRequest" },
      "description": "Hospital & clinic direct global sourcing and DGDA NPA / compassionate use requests persisted under a user's workspace."
    }
  }
}
